# =====================================================================
#  Sao chép file này thành .env rồi sửa mật khẩu:
#      Windows PowerShell:  Copy-Item .env.example .env
#      Git Bash / Linux:    cp .env.example .env
#  File .env đã được .gitignore bỏ qua - KHÔNG commit lên GitHub.
# =====================================================================

# ---------- Máy chủ đám mây ----------
# Tên miền đã trỏ về IP máy chủ. Caddy dùng nó để xin chứng chỉ https.
SITE_DOMAIN=iot-kitchen-hcmute.duckdns.org

# ---------- Thiết bị ----------
# Phải trùng với device_id mà ESP32 (TV2) nạp vào firmware - Bản thống nhất mục 2.1
DEVICE_ID=esp32_kitchen_01

# ---------- PostgreSQL / TimescaleDB ----------
POSTGRES_DB=iot_kitchen
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=IotKitchen2026aA

# ---------- MQTT ----------
MQTT_TLS=false                  # true khi dùng broker đám mây (HiveMQ) hoặc broker có chứng chỉ
MQTT_CA_CERT=                   # để trống = dùng kho chứng chỉ gốc của hệ thống
# 3 tài khoản được tạo tự động lúc container mosquitto khởi động:
#   backend_svc   -> Backend (toàn quyền trong nhánh iot/kitchen/#)
#   esp32_device  -> ESP32 (TV2 nạp vào firmware)
#   web_dashboard -> Dashboard (TV4 dùng trong JavaScript, CHỈ ĐỌC)
MQTT_BACKEND_PASSWORD=Backend2026aA
MQTT_DEVICE_PASSWORD=Esp32Dev2026aA
MQTT_WEB_PASSWORD=WebDash2026aA

# ---------- Cảnh báo ----------

# --- Telegram: kênh cảnh báo duy nhất, miễn phí (xem README mục 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MAX_PER_MINUTE=20

# --- Discord: kênh thứ hai, tuỳ chọn, miễn phí (xem docs/discord-alerts.md) ---
# Để trống thì không gửi Discord. Điền đường link webhook là tự bật, không cần đổi gì khác.
DISCORD_WEBHOOK_URL=
# Gọi tên ở tin cảnh báo đầu để điện thoại chắc chắn rung: @everyone hoặc <@mã_người_dùng>
DISCORD_MENTION=
DISCORD_MAX_PER_MINUTE=20

# Chống spam (đơn vị: giây). QUAN TRỌNG: file .env cũ ghi 60 và 300,
# phải sửa thành 600 thì mới đúng "10 phút gửi lại 1 lần".
ALERT_COOLDOWN_SECONDS=600      # 2 đợt cảnh báo MỚI cách nhau tối thiểu 10 phút
ALERT_REMINDER_SECONDS=600      # vẫn vượt ngưỡng thì 10 phút nhắc lại 1 lần

# ---------- Bảo mật (BẮT BUỘC khi mở ra Internet) ----------
# Để trống = không kiểm tra, chỉ dùng khi chạy trong mạng LAN.
# Khi công khai qua Cloudflare Tunnel thì PHẢI đặt, nếu không ai biết địa chỉ
# cũng bật tắt được quạt nhà bạn. Sinh khoá ngẫu nhiên bằng PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
READ_ONLY=false                 # true = chặn mọi lệnh ghi, kể cả khi khoá đúng

# ---------- Mô hình AI (Tuần 2) ----------
AI_ENABLED=true                 # đặt false để tắt hẳn phần dự báo
AI_INTERVAL_SECONDS=10          # chu kỳ suy luận, theo Bản thống nhất mục 6
AI_SAMPLE_SECONDS=10            # chu kỳ 1 mẫu mà TV5 dùng lúc train (KHÔNG phải 2s của cảm biến)
AI_WINDOW_SIZE=20               # chỉ là giá trị dự phòng, Backend tự lấy theo mô hình thật
AI_PORT_HOST=9100

# ---------- Khác ----------
LOG_LEVEL=INFO                  # đổi thành DEBUG khi cần soi từng bản tin MQTT
CORS_ORIGINS=*                  # khi nộp bài nên ghi rõ: http://localhost:5173,http://localhost:3000

# ---------- Cổng (chỉ đổi khi bị trùng cổng) ----------
# VD: máy đã cài sẵn PostgreSQL thì đặt PG_PORT_HOST=5433 rồi kết nối DBeaver vào cổng 5433.
#
# KHI CHẠY TRÊN MÁY CHỦ ĐÁM MÂY, thêm tiền tố 127.0.0.1: để cổng chỉ nghe nội bộ,
# chỉ Caddy gọi được, Internet không chạm tới (xem docs/cloud-deployment.md):
#   API_PORT_HOST=127.0.0.1:8000
#   PG_PORT_HOST=127.0.0.1:5432
#   WS_PORT_HOST=127.0.0.1:9001
#   AI_PORT_HOST=127.0.0.1:9100
# Riêng MQTT_PORT_HOST giữ nguyên 1883 vì ESP32 phải nối thẳng vào.
MQTT_PORT_HOST=1883
WS_PORT_HOST=9001
API_PORT_HOST=8000
PG_PORT_HOST=5432
