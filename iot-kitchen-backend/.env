# =====================================================================
#  Sao chép file này thành .env rồi sửa mật khẩu:
#      Windows PowerShell:  Copy-Item .env.example .env
#      Git Bash / Linux:    cp .env.example .env
#  File .env đã được .gitignore bỏ qua - KHÔNG commit lên GitHub.
# =====================================================================

# ---------- Thiết bị ----------
# Phải trùng với device_id mà ESP32 (TV2) nạp vào firmware - Bản thống nhất mục 2.1
DEVICE_ID=esp32_kitchen_01

# ---------- PostgreSQL / TimescaleDB ----------
POSTGRES_DB=iot_kitchen
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=IotKitchen2026aA

# ---------- MQTT ----------
# 3 tài khoản được tạo tự động lúc container mosquitto khởi động:
#   backend_svc   -> Backend (toàn quyền trong nhánh iot/kitchen/#)
#   esp32_device  -> ESP32 (TV2 nạp vào firmware)
#   web_dashboard -> Dashboard (TV4 dùng trong JavaScript, CHỈ ĐỌC)
MQTT_BACKEND_PASSWORD=BackEndPass
MQTT_DEVICE_PASSWORD=Esp32S3Pass
MQTT_WEB_PASSWORD=WebAppPass

# ---------- Telegram ----------
# Cách lấy (xem README mục 6):
#   1. Nhắn /newbot cho @BotFather -> nhận TOKEN
#   2. Nhắn 1 tin bất kỳ cho bot vừa tạo
#   3. Mở https://api.telegram.org/bot<TOKEN>/getUpdates -> lấy "chat":{"id": ...}
# Để trống cũng chạy được: cảnh báo vẫn ghi vào bảng system_events, chỉ không gửi tin.
TELEGRAM_BOT_TOKEN=8881006459:AAFdsL4wzdR6Z_cPCDk7hZjxmpjpPKxK8qw
TELEGRAM_CHAT_ID=8114620353

# Chống spam (đơn vị: giây)
ALERT_COOLDOWN_SECONDS=60       # 2 cảnh báo MỚI cùng loại phải cách nhau ít nhất 60 s
ALERT_REMINDER_SECONDS=300      # vẫn vượt ngưỡng thì 5 phút nhắc lại 1 lần
TELEGRAM_MAX_PER_MINUTE=20      # trần toàn hệ thống: 20 tin/phút (giới hạn của Telegram là 30)

# ---------- Khác ----------
LOG_LEVEL=INFO                  # đổi thành DEBUG khi cần soi từng bản tin MQTT
CORS_ORIGINS=https://kitchen-dashboard-web.vercel.app/,http://localhost:5173 #tv4                # khi nộp bài nên ghi rõ: http://localhost:5173,http://localhost:3000

# ---------- Cổng phía Windows (chỉ đổi khi bị trùng cổng) ----------
# VD: máy đã cài sẵn PostgreSQL thì đặt PG_PORT_HOST=5433 rồi kết nối DBeaver vào cổng 5433.
MQTT_PORT_HOST=1883
WS_PORT_HOST=9001
API_PORT_HOST=8000
PG_PORT_HOST=5432
API_KEY=kPxRoygk4rP45J1Rs1QrJJ0OMcdvpXxwR-HTnohwL0c
READ_ONLY=false